generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserStatus {
  PENDING
  APPROVED
  REJECTED
}

enum UserRole {
  MEMBER
  MODERATOR
  ADMIN
}

enum XpKind {
  DAILY_LOGIN
  COMMENT
  LIKE_GIVEN
  LIKE_RECEIVED
  RECIPE_PUBLISHED
}

enum RecipeStatus {
  PENDING
  PUBLISHED
  REJECTED
}

model User {
  id             String     @id @default(cuid())
  email          String     @unique
  name           String
  avatarUrl      String?
  status         UserStatus @default(PENDING)
  role           UserRole   @default(MEMBER)
  bondNumber     String?
  pledgeClass    String?
  graduationYear Int?

  /// Running total of XpEvent.points — denormalised so a level can sit next to a
  /// name without summing the ledger on every render. Level is derived from it.
  xp Int @default(0)

  bigId   String?
  big     User?   @relation("BigLittle", fields: [bigId], references: [id], onDelete: SetNull)
  littles User[]  @relation("BigLittle")

  accounts Account[]
  sessions Session[]

  recipesSubmitted Recipe[]      @relation("RecipeSubmitter")
  recipesReviewed  Recipe[]      @relation("RecipeReviewer")
  comments         Comment[]
  likes            Like[]
  commentLikes     CommentLike[]
  xpEvents         XpEvent[]
  badges           UserBadge[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([bigId])
}

model Recipe {
  id            String   @id @default(cuid())
  title         String
  ingredients   String
  instructions  String
  photoUrl      String?
  category      String
  tags          String[] @default([])
  submitterName String

  submittedById String?
  submittedBy   User?   @relation("RecipeSubmitter", fields: [submittedById], references: [id], onDelete: SetNull)

  status          RecipeStatus @default(PENDING)
  reviewedById    String?
  reviewedBy      User?        @relation("RecipeReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt      DateTime?
  rejectionReason String?

  comments Comment[]
  likes    Like[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([category])
  @@index([tags], type: Gin)
}

model Comment {
  id        String   @id @default(cuid())
  recipeId  String
  recipe    Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())

  /// Set for replies. Deleting a comment deletes its whole sub-thread.
  parentId String?
  parent   Comment?      @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  Comment[]     @relation("CommentReplies")
  likes    CommentLike[]

  @@index([recipeId])
  @@index([parentId])
}

model CommentLike {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  commentId String
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, commentId])
  @@index([commentId])
}

model Like {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipeId  String
  recipe    Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, recipeId])
  @@index([recipeId])
}

/// Append-only XP ledger. `refKey` identifies *what* earned the XP (a recipe id,
/// a comment id, a date, ...) so the unique constraint makes every award
/// idempotent: the same thing can never pay out twice, even across un-like /
/// re-like or double submits.
model XpEvent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      XpKind
  refKey    String
  points    Int
  /// Context only (no FK) so history survives a recipe being deleted.
  recipeId  String?
  createdAt DateTime @default(now())

  @@unique([userId, kind, refKey])
  @@index([userId, kind, createdAt])
}

/// Achievements a user has earned. Definitions live in lib/badges.ts.
model UserBadge {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badgeKey  String
  awardedAt DateTime @default(now())

  @@id([userId, badgeKey])
}

// --- Auth.js (NextAuth) required models ---

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
