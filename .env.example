# --- Database (Neon in production; local Postgres in dev) ---
DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"
DIRECT_URL="postgresql://user:password@host:5432/dbname?schema=public"

# --- Auth.js ---
AUTH_SECRET="generate with: openssl rand -base64 32"

# Google OAuth client (Google Cloud Console -> APIs & Services -> Credentials)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- Vercel Blob (photo uploads) ---
BLOB_READ_WRITE_TOKEN=""

# --- Admin bootstrap ---
# This email is auto-approved as ADMIN the first time it signs in with Google.
ADMIN_EMAIL="you@example.com"
